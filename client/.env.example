# =================================================================
# Client (Vite) build-time env vars
# -----------------------------------------------------------------
# Vite inlines anything prefixed VITE_* into the bundle at build
# time. Anon key is the PUBLIC Supabase key - safe to ship to the
# browser since RLS gates everything server-side.
#
# Do NOT put your service-role key here.
# =================================================================

# From Supabase Project Settings > API > Project URL
VITE_SUPABASE_URL=

# From Supabase Project Settings > API > Project API keys > anon (public)
VITE_SUPABASE_ANON_KEY=

# Override only if the SPA is served from a different origin than
# the API (e.g. CDN vs separate API host). Same-origin (Express
# serves dist/ alongside the API on :3000) -> leave blank.
VITE_API_BASE_URL=
