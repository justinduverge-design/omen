{
  "schema_version": "canvas-contract-requirements.v1",
  "canvas": "design/native-visual-lock-2026-09-13",
  "contract_directory": "Blueprints/specs/design/screen-contracts",
  "global": {
    "ios_min_hit_target_pt": 44,
    "android_min_hit_target_dp": 48,
    "dynamic_type": "required_reflow",
    "font_scale": "required_reflow",
    "long_content": "wrap_then_vertical_scroll",
    "horizontal_overflow": "forbidden",
    "device_floor": { "width": 390, "height": 844 },
    "compact_floor": { "width": 375, "height": 667, "vertical_scroll_allowed": true },
    "required_state_classes": ["nominal", "loading", "empty", "error", "degraded", "unavailable", "partial"]
  },
  "journeys": {
    "J1": ["SignIn", "EmailCode", "ConnectLeague", "EspnConnect", "ConnectFailed", "CommandNoLeague"],
    "J2": ["CommandCenter", "CommandQuiet", "CommandQuietStraight", "SwitchSheet", "SwitchLoading"],
    "J3": ["OmenCall", "OmenEvidence", "StartSitClear", "StartSitIncomplete"],
    "J4": ["TradeBuild", "TradeRoster", "TradeNeedsContext", "TradeVerdict", "TradeShare"],
    "J5": ["LeagueTable", "LeagueWaiver", "LeagueDegraded", "LeagueNoRosters", "WaiverNoMove", "WaiverNotDetermined"],
    "J6": ["Ledger", "LedgerDetail", "LedgerDegraded", "LedgerDetailDegraded"],
    "chrome": ["Account", "ReportPill"]
  },
  "screens": [
    {"id":"SignIn","family":"Onboarding & connection","journey":"J1","states":["nominal"],"api_contracts":["session.v1"],"scroll":"fits"},
    {"id":"EmailCode","family":"Onboarding & connection","journey":"J1","states":["nominal"],"api_contracts":[],"scroll":"fits"},
    {"id":"ConnectLeague","family":"Onboarding & connection","journey":"J1","states":["empty","nominal"],"api_contracts":["platform-provider-state.v1"],"scroll":"fits"},
    {"id":"EspnConnect","family":"Onboarding & connection","journey":"J1","states":["nominal"],"api_contracts":["espn-connect.v1"],"scroll":"scrolls"},
    {"id":"ConnectFailed","family":"Onboarding & connection","journey":"J1","states":["error","degraded"],"api_contracts":["platform-provider-state.v1"],"scroll":"scrolls"},
    {"id":"CommandNoLeague","family":"Command Center","journey":"J1","states":["empty"],"api_contracts":["dashboard-summary.v1"],"scroll":"fits"},
    {"id":"CommandCenter","family":"Command Center","journey":"J2","states":["nominal","partial","degraded"],"api_contracts":["dashboard-summary.v1","league-overview.v1","waiver-analysis.v1","moves-history.v2"],"scroll":"fits"},
    {"id":"CommandQuiet","family":"Command Center","journey":"J2","states":["empty","nominal"],"api_contracts":["quiet-week.v1"],"scroll":"fits"},
    {"id":"CommandQuietStraight","family":"Command Center","journey":"J2","states":["degraded","unavailable"],"api_contracts":["quiet-week.v1"],"scroll":"fits"},
    {"id":"SwitchSheet","family":"Ledger, switcher, account","journey":"J2","states":["nominal"],"api_contracts":["league-directory.v1","active-league.v1"],"scroll":"fits"},
    {"id":"SwitchLoading","family":"Ledger, switcher, account","journey":"J2","states":["loading","partial"],"api_contracts":["active-league.v1"],"scroll":"fits"},
    {"id":"OmenCall","family":"Omen","journey":"J3","states":["nominal","degraded","unavailable"],"api_contracts":["omen-decision-brief.v3"],"scroll":"fits"},
    {"id":"OmenEvidence","family":"Omen","journey":"J3","states":["nominal","degraded","unavailable","partial"],"api_contracts":["omen-decision-brief.v3"],"scroll":"scrolls"},
    {"id":"StartSitClear","family":"Omen","journey":"J3","states":["nominal"],"api_contracts":["start-sit-detail.v1"],"scroll":"fits"},
    {"id":"StartSitIncomplete","family":"Omen","journey":"J3","states":["degraded","partial","unavailable"],"api_contracts":["start-sit-detail.v1"],"scroll":"scrolls"},
    {"id":"TradeBuild","family":"Trade","journey":"J4","states":["nominal","partial"],"api_contracts":["trade-capabilities.v1","trade-compare.v2"],"scroll":"scrolls"},
    {"id":"TradeRoster","family":"Trade","journey":"J4","states":["nominal","unavailable"],"api_contracts":["trade-capabilities.v1","trade-compare.v2"],"scroll":"scrolls"},
    {"id":"TradeNeedsContext","family":"Trade","journey":"J4","states":["degraded","partial"],"api_contracts":["trade-compare.v2"],"scroll":"scrolls"},
    {"id":"TradeVerdict","family":"Trade","journey":"J4","states":["nominal"],"api_contracts":["trade-compare.v2"],"scroll":"scrolls"},
    {"id":"TradeShare","family":"Trade","journey":"J4","states":["nominal","error"],"api_contracts":["trade-share.v1"],"scroll":"scrolls"},
    {"id":"LeagueTable","family":"League & waiver","journey":"J5","states":["nominal","partial"],"api_contracts":["league-overview.v1"],"scroll":"scrolls"},
    {"id":"LeagueWaiver","family":"League & waiver","journey":"J5","states":["nominal"],"api_contracts":["waiver-analysis.v1"],"scroll":"scrolls"},
    {"id":"LeagueDegraded","family":"League & waiver","journey":"J5","states":["degraded","partial","unavailable"],"api_contracts":["league-overview.v1"],"scroll":"scrolls"},
    {"id":"LeagueNoRosters","family":"League & waiver","journey":"J5","states":["unavailable"],"api_contracts":["league-overview.v1"],"scroll":"scrolls"},
    {"id":"WaiverNoMove","family":"League & waiver","journey":"J5","states":["empty","nominal"],"api_contracts":["waiver-analysis.v1"],"scroll":"fits"},
    {"id":"WaiverNotDetermined","family":"League & waiver","journey":"J5","states":["degraded","unavailable"],"api_contracts":["waiver-analysis.v1"],"scroll":"scrolls"},
    {"id":"Ledger","family":"Ledger, switcher, account","journey":"J6","states":["nominal","partial"],"api_contracts":["moves-history.v2"],"scroll":"scrolls"},
    {"id":"LedgerDetail","family":"Ledger, switcher, account","journey":"J6","states":["nominal","partial"],"api_contracts":["move-detail.v1"],"scroll":"scrolls"},
    {"id":"LedgerDegraded","family":"Ledger, switcher, account","journey":"J6","states":["degraded","unavailable","partial"],"api_contracts":["moves-history.v2"],"scroll":"scrolls"},
    {"id":"LedgerDetailDegraded","family":"Ledger, switcher, account","journey":"J6","states":["degraded","unavailable","partial"],"api_contracts":["move-detail.v1"],"scroll":"scrolls"},
    {"id":"Account","family":"Ledger, switcher, account","journey":"chrome","states":["nominal"],"api_contracts":["dashboard-summary.v1","user-export.v1","user-delete.v1"],"scroll":"scrolls"},
    {"id":"ReportPill","family":"Command Center","journey":"chrome","states":["nominal","error"],"api_contracts":["beta-report.v1"],"scroll":"fits"}
  ]
}
