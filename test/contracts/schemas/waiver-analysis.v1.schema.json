        "system": {
          "type": "string"
        },
        "budget_text": {
          "type": [
            "null",
            "string"
          ],
          "description": "Composed server-side, e.g. \"Your budget $80 of $100\". Null unless budget_total and budget_remaining are both known. The native League screen renders a FAAB budget only from this field."
        },
        "order_text": {
          "type": [
            "null",
            "string"
          ],
          "description": "Composed server-side, e.g. \"Claim order 7\". Null unless the league runs priority waivers and the position is known."
        }
