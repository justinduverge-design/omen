            "name": {
              "type": "string"
            },
            "player_key": {
              "type": "string"
            },
            "position": {
              "type": "string"
            },
            "projected_points": {
              "type": "number"
            },
            "status": {
              "description": "Observed only as null in recorded responses; the real type is not constrained."
            },
            "team": {
              "description": "Observed only as null in recorded responses; the real type is not constrained."
            }
          },
          "required": [
            "name",
            "player_key",
            "position",
            "projected_points",
            "status",
            "team"
