{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sleeper-resolve.v1",
  "title": "sleeper-resolve.v1 (inferred from recorded server responses; review before relying on it)",
  "description": "ADDITIVE ONLY within this version. Extra properties are allowed; removing, renaming or retyping anything listed here is a breaking change and fails the lock.",
  "type": "object",
  "properties": {
    "leagues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "scoring_format": {
            "type": "string"
          },
          "season": {
            "type": "number"
          },
          "team_id": {
            "type": "string"
          },
          "team_name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "scoring_format",
          "season",
          "team_id",
          "team_name"
        ]
      }
    },
    "platform": {
      "type": "string"
    },
    "season": {
      "type": "number"
    },
    "sleeper_user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "resolved"
      ]
    },
    "username": {
      "type": "string"
    }
  },
  "required": [
    "leagues",
    "platform",
    "season",
    "sleeper_user_id",
    "status",
    "username"
  ]
}
