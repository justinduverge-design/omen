# --- SERVER CONFIGURATION ---
# The port your Node.js app listens on inside the container
PORT=
# The public URL of your application (used for generating absolute links)
APP_BASE_URL=

# --- SUPABASE CONFIGURATION ---
# Found in Supabase Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- UPSTASH REDIS (REST CONFIGURATION) ---
# Use the 'REST' tab in the Upstash console.
# The URL must start with https://
REDIS_URL=
REDIS_TOKEN=

# --- TUESDAY SCORING CRON ---
# Keep false until weekly scoring has been validated against production data.
OMEN_CRON_SCORING_ENABLED=false
SPORTRADAR_API_KEY=

# --- YAHOO DEVELOPER API ---
# These are generated after clicking "Create App" in the Yahoo Developer portal
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# This MUST match the Redirect URI you entered in the Yahoo portal exactly
YAHOO_REDIRECT_URI=

# --- LOGGING ---
# winston level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# --- CORS ---
# Comma-separated list of allowed origins. Leave blank to allow only same-origin
# (and http://localhost:* in development). Example:
# CORS_ORIGINS=https://ssffmvp.com,https://www.ssffmvp.com
CORS_ORIGINS=

# --- STRIPE ---
# From dashboard.stripe.com - sk_test_... in dev, sk_live_... in prod
STRIPE_SECRET_KEY=
# From the webhook endpoint detail page (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Price IDs (price_...) for the two plans
STRIPE_MONTHLY_PRICE_ID=
STRIPE_SEASON_PRICE_ID=

# --- ANTHROPIC ---
ANTHROPIC_API_KEY=

# LLM inference (Ollama on Hostinger VPS)
# Keep Ollama private or firewall-restricted. Do not expose it as a public API.
# Prefer a private network, SSH tunnel, or allowlisted backend-to-backend path.
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma3:4b
LLM_TIMEOUT=30000

# Set to "true" to show the ESPN connection card in the frontend.
# Must also be passed as a Docker build arg via deploy.yml.
# Leave unset or set to "" to keep ESPN hidden.
VITE_ESPN_ENABLED=

# --- PUBLIC MOCK CONTRACTS ---
# GET /api/omen-of-the-week returns deterministic mock data without secrets.
# Authenticated live Yahoo Omen uses existing Supabase + Yahoo OAuth/Vault
# configuration; no additional Omen-specific env vars are required.

# --- OPTIONAL / MISC ---
# Helpful for debugging during this "backend-only" phase
NODE_ENV=

# --- SENTRY (error tracking) ---
# Leave blank locally and in CI to disable Sentry (init becomes a no-op).
# Set in deploy/hostinger/.env.production on KVM1 only.
SENTRY_DSN=
# Public Sentry DSN baked into the SPA bundle at Vite build time. Blank = no-op.
# Set as a Docker build arg (not a runtime env) when building the frontend image.
VITE_SENTRY_DSN=
