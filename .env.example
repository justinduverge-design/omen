# --- SERVER CONFIGURATION ---
# The port your Node.js app listens on inside the container
PORT=
# The public URL of your application (used for generating absolute links)
APP_BASE_URL=

# --- SUPABASE CONFIGURATION ---
# Found in Supabase Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- UPSTASH REDIS (REST CONFIGURATION) ---
# Use the 'REST' tab in the Upstash console.
# The URL must start with https://
REDIS_URL=
REDIS_TOKEN=

# --- YAHOO DEVELOPER API ---
# These are generated after clicking "Create App" in the Yahoo Developer portal
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# This MUST match the Redirect URI you entered in the Yahoo portal exactly
YAHOO_REDIRECT_URI=

# --- LOGGING ---
# winston level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# --- CORS ---
# Comma-separated list of allowed origins. Leave blank to allow only same-origin
# (and http://localhost:* in development). Example:
# CORS_ORIGINS=https://ssffmvp.com,https://www.ssffmvp.com
CORS_ORIGINS=

# --- STRIPE ---
# From dashboard.stripe.com - sk_test_... in dev, sk_live_... in prod
STRIPE_SECRET_KEY=
# From the webhook endpoint detail page (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Price IDs (price_...) for the two plans
STRIPE_MONTHLY_PRICE_ID=
STRIPE_SEASON_PRICE_ID=

# --- ANTHROPIC ---
ANTHROPIC_API_KEY=

# LLM inference (Ollama on Hostinger VPS)
LLM_BASE_URL=http://2.24.79.103:11434
LLM_MODEL=gemma3:4b
LLM_TIMEOUT=30000

# --- OPTIONAL / MISC ---
# Helpful for debugging during this "backend-only" phase
NODE_ENV=
