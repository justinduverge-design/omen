{
  "manifest_version": 3,
  "name": "Omen ESPN Connect",
  "version": "0.1.0",
  "description": "Fills Omen's ESPN connection form from your browser session. Local-only; you review and submit the form.",
  "permissions": ["cookies", "storage", "activeTab"],
  "host_permissions": ["https://*.espn.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://slopssaloon.com/account/connect*",
        "http://localhost:5173/account/connect*"
      ],
      "js": ["content-omen.js"],
      "run_at": "document_idle"
    }
  ]
}
