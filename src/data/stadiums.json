{
  "_meta": {
    "purpose": "Venue coordinates and roof type for game-weather lookups, keyed by nflverse stadium_id.",
    "source": "Coordinates entered by hand to about 0.01 degrees (venue-level, adequate for a forecast grid cell); roof_type is the modal nflverse roof value 2023-2026 where the venue is a US stadium. Checked by scripts/check-stadiums.mjs against Open-Meteo's reported timezone and elevation.",
    "roof_type_values": {
      "outdoors": "Open air. Weather applies.",
      "dome": "Fixed roof or canopy. Weather does not apply.",
      "retractable": "Roof state is decided close to kickoff and is not known in advance. Weather applies only when the roof is open, so consumers must weight it by an open-roof probability, never assume either state."
    },
    "reviewed": "2026-09-30",
    "historic_note": "Venues used 1999-2019 that are closed, replaced or one-off (London, Baton Rouge, San Antonio, Champaign) were added 2026-10-17 for the historical weather backfill, coordinates to about 0.01 degrees; roof is the venue type when used."
  },
