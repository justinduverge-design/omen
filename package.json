{
  "name": "omen",
  "version": "1.0.0",
  "description": "Omen \u2014 Slops Saloon Fantasy Football Intelligence",
  "main": "src/server.js",
  "scripts": {
    "native:retired-paths:check": "node scripts/check-retired-native-paths.mjs",
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "cron": "node src/omen_tuesday_cron.js",
    "test": "node --test \"test/**/*.js\" \"test/**/*.mjs\"",
    "evals:validate": "node evals/slops-prompt-guard.mjs --validate",
    "evals:mock": "node evals/slops-prompt-guard.mjs",
    "contracts:record": "node scripts/contract-recorded.js record",
    "contracts:check": "node scripts/contracts.js check && node scripts/contract-recorded.js check",
    "contracts:lock": "node scripts/contracts.js lock",
    "prune:check": "node scripts/check-orphans.js",
    "prune:mac": "bash scripts/mac-sweep.sh",
    "closeout": "bash scripts/closeout.sh",
    "merge": "bash scripts/merge-pr.sh",
    "check:pii": "node scripts/checks/no-pii-outbound.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@sentry/node": "^11.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/redis": "^1.39.0",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "espn-fantasy-football-api": "^2.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "ajv": "^8.20.0",
    "impeccable": "^4.7.0",
    "playwright-core": "^1.64.1"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "@opentelemetry/core": "2.8.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-trace-base": "2.8.0"
  }
}
