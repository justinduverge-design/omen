// Public, non-secret build configuration for OmenIOS.
//
// This file is committed and defines safe defaults so `xcodebuild` (including unsigned CI)
// always has a valid config to build against. Real Supabase URL/anon key values belong in a
// git-ignored `Local.xcconfig` in this same directory (see `Local.xcconfig.example`) — the iOS
// analog of Android's `local.properties`. Never put a secret (service-role key, OAuth client
// secret, etc.) in either file: only a public API base URL and a public Supabase URL/anon key
// ever belong here.
//
// URL SYNTAX — READ BEFORE EDITING A URL HERE. In xcconfig, `//` begins a comment, so a bare
// `https://host` silently truncates to `https:`. The older `https:$()//host` workaround no
// longer works: Xcode 26 strips comments *before* expanding `$()`, so it also yields `https:`.
// Use the `$(OMEN_SLASH)` indirection below, which expands correctly. Verified on Xcode 26.6.
// The truncation is silent — it reaches `Info.plist` and ships in the build.

OMEN_SLASH = /

OMEN_API_BASE_URL = https:$(OMEN_SLASH)$(OMEN_SLASH)example.invalid
OMEN_SUPABASE_URL =
OMEN_SUPABASE_ANON_KEY =

// O6 iOS crash reporting. Blank disables the handler entirely (init becomes a no-op),
// matching Android's `omen.androidSentryDsn` and the backend's blank-SENTRY_DSN behavior.
// A DSN is a public client key, not a secret — but it stays out of git anyway so a fork
// cannot post noise into our project. Set it in the git-ignored Local.xcconfig.
OMEN_IOS_SENTRY_DSN =

// O7 forced-update gate destination. Blank until the App Store listing is live —
// the gate still blocks correctly with it unset, the button just has nowhere to go,
// so don't raise MIN_APP_VERSION_IOS before this is filled in.
OMEN_IOS_APP_STORE_URL =

#include? "Local.xcconfig"
