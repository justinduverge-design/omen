# ════════════════════════════════════════════════════════════════
# Slops Saloon Fantasy Football MVP - Dockerfile.cron
# Dedicated image for the Tuesday cron worker.
# Uses Alpine's built-in crond daemon to schedule omen_tuesday_cron.js
# at 6:00 AM EST every Tuesday without any external cron library.
# ════════════════════════════════════════════════════════════════

# ── STAGE 1: Builder ─────────────────────────────────────────────
FROM node:24-alpine AS builder

RUN apk add --no-cache python3 make g++

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY src/    ./src/
COPY client/ ./client/


# ── STAGE 2: Production ──────────────────────────────────────────
FROM node:24-alpine AS production

# Install tini (proper PID 1 init) and crond
RUN apk add --no-cache tini dcron

# Security: non-root user
RUN addgroup -S ssffmvp && adduser -S ssffmvp -G ssffmvp

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/src    ./src
COPY --from=builder /app/client ./client
COPY package.json ./

# ── CRONTAB ──────────────────────────────────────────────────────
# Schedule: 6:00 AM every Tuesday (TZ=America/New_York set in compose)
# Format:   min hour day month weekday command
# Weekday 2 = Tuesday
# Output is appended to /var/log/omen_cron.log
RUN echo "0 6 * * 2 node /app/src/omen_tuesday_cron.js >> /var/log/omen_cron.log 2>&1" \
    > /var/spool/cron/crontabs/ssffmvp

# Ensure permissions are correct for the crond daemon to read it
RUN chmod 0600 /var/spool/cron/crontabs/ssffmvp

# Give the non-root user ownership of the log file location
RUN touch /var/log/omen_cron.log \
    && chown ssffmvp:ssffmvp /var/log/omen_cron.log

ENV NODE_ENV=production

# Build provenance, same rationale as Dockerfile. The cron container has no HTTP
# surface to report from, but `docker inspect` and its log lines can name the
# commit, which is what the 2026-08-26 silent-deploy incident needed.
ARG GIT_SHA
ARG BUILD_ID
ARG IMAGE_TAG
ENV GITHUB_SHA=$GIT_SHA
ENV BUILD_ID=$BUILD_ID
ENV IMAGE_TAG=$IMAGE_TAG

# ── ENTRYPOINT ───────────────────────────────────────────────────
# tini handles signals cleanly (SIGTERM on docker stop)
# crond -f -d 8 runs in foreground with debug level 8
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["crond", "-f", "-d", "8", "-c", "/var/spool/cron/crontabs"]
