#!/bin/sh
set -eu
key=/home/darthslops/.ssh/slops-alerting_ed25519
state=/var/lib/slops-alerting/last-signature
football_state=/var/lib/slops-alerting/football-last-signature
a4_state=/var/lib/slops-alerting/a4-gates-last-signature
# Day-stamp of the last delivered notification. Edge-triggered alerting is the
# right default for noise, but it made a CRITICAL condition invisible: the
# football signature latched on 2026-08-27 when capture began failing and stayed
# silent for 17 days, because an unchanged signature never re-sends. A once-daily
# re-send of whatever is still active bounds that blind spot to 24h without
# reintroducing per-run spam.
reminder_state=/var/lib/slops-alerting/last-reminder-day
webhook=/etc/slops-alerting/discord-webhook-url
# Build the payload with a real JSON encoder rather than string interpolation.
# The old form could only ever deliver a SINGLE-LINE alert: a multi-signal
# signature embeds raw newlines in the JSON string, which Discord rejects with
# 400. So if two things had broken at the same time, the alert would have
# failed and no notification would have gone out at all - the alerting system
# failing precisely when it mattered most. Found 2026-08-21 when GlitchTip
# became the fourth signal source and produced the first multi-line signature.
send() {
  printf '%s' "$1" | python3 -c 'import json,sys; sys.stdout.write(json.dumps({"content": sys.stdin.read()}))' \
    | curl -fsS --max-time 15 -H 'Content-Type: application/json' --data-binary @- "$(cat "$webhook")" >/dev/null
}
if [ "${1:-}" = --test ]; then send 'SLOPS ALERT TEST: Discord delivery is working. No infrastructure fault was created.'; exit 0; fi
mkdir -p /var/lib/slops-alerting
bad="$({ sudo -u darthslops ssh -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=yes darthslops@steward 2>/dev/null; sudo -u darthslops ssh -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=yes darthslops@sentinel 2>/dev/null; } | grep '^result=' | grep -v '=HEALTHY' || true)"
kuma="$(docker exec uptime-kuma sqlite3 -readonly -csv /app/data/kuma.db 'SELECT m.name,(SELECT h.status FROM heartbeat h WHERE h.monitor_id=m.id ORDER BY h.time DESC LIMIT 1) FROM monitor m WHERE m.active=1' | awk -F, '$2 != 1 {print $1 ": status=" $2}')"
pihole="$(/usr/local/lib/slops-alerting/pihole-dns-probe.py 2>&1 || true)"
# O9: unresolved GlitchTip issues. Read straight from Postgres, the same way
# Kuma is read straight from SQLite above - no API token to provision, and the
# transaction is forced read-only so this path cannot mutate error records.
# Signature carries issue identity only, never the event count: a new issue
# alerts once, a flapping issue accumulating events stays quiet, and resolving
# every issue produces one recovery notice. Titles are error text and therefore
# vendor-controlled, so quotes, backslashes and control characters are stripped
# before they can reach the Discord JSON payload.
# GlitchTip being down yields an empty result, not a false all-clear: Kuma's own
# GlitchTip monitor covers that case through the kuma signal above.
glitchtip="$(docker exec -e PGOPTIONS='-c default_transaction_read_only=on' glitchtip-postgres psql -U "$(docker exec glitchtip-postgres printenv POSTGRES_USER)" -d glitchtip -At -F'|' -c "SELECT i.short_id, i.title FROM issue_events_issue i JOIN issue_events_issueindex x ON x.issue_id = i.id WHERE x.status = 0 AND i.is_deleted = false ORDER BY i.short_id" 2>/dev/null | awk -F'|' '{t=$2; gsub(/[\\"]/,"",t); gsub(/[[:cntrl:]]/," ",t); if (length(t)>90) t=substr(t,1,90) "..."; print "GlitchTip #" $1 ": " t}' || true)"
football="$(python3 -c 'import json,sys
allowed={"job_failure","source_loss","schema_drift","stale_data","disk_low","witness_mismatch","witness_outage"}
try:
 data=json.load(open(sys.argv[1],encoding="utf-8")); rows=data.get("conditions",[])
 if data.get("schema")!="omen-football-alert-signals.v1" or any(r.get("code") not in allowed for r in rows): raise ValueError()
 for row in sorted(rows,key=lambda r:r["code"]): print("Omen football: %s severity=%s"%(row["code"],row.get("severity","high")))
except Exception:
 print("Omen football: witness_outage severity=high")' /var/lib/omen-football-witness/signals.json)"
# A production status payload that stops ADVANCING is invisible to every check
# above. The fetch keeps succeeding, so the file mtime refreshes every run while
# generated_at_utc inside it stays frozen - which is exactly how the Aug 27
# capture failure hid for 17 days. Age the payload contents explicitly. 30h
# tolerates the daily 09:15 capture slipping or a single missed run.
stale="$(python3 -c 'import json,sys,datetime
try:
 d=json.load(open(sys.argv[1],encoding="utf-8"))
 t=datetime.datetime.fromisoformat(d["generated_at_utc"].replace("Z","+00:00"))
 hours=(datetime.datetime.now(datetime.timezone.utc)-t).total_seconds()/3600
 if hours>30: print("Omen football status payload is STALE: %d hours old (generated %s)"%(hours,d["generated_at_utc"]))
except FileNotFoundError:
 pass
except Exception:
 print("Omen football status payload is unreadable or malformed")' /var/lib/omen-football-witness/remote/kvm1-status.json)"
football_old="$(cat "$football_state" 2>/dev/null || true)"
if [ "$football" != "$football_old" ]; then
  if [ -n "$football" ]; then
    send "SLOPS ALERT: Omen football-data state change
$football"
  elif [ -n "$football_old" ]; then
    send 'SLOPS RECOVERY: Omen football-data alert conditions are healthy again.'
  fi
  printf '%s\n' "$football" > "$football_state"
fi
# A4 Tuesday-scoring gates. Unlike every other signal here, GREEN is the newsworthy state:
# this reports when scoring becomes enablable, and when it has actually been enabled. A
# stale or unparseable file is reported as a checker fault rather than silently treated as
# "not ready", so the absence of a green light is never mistaken for a working check.
a4="$(python3 -c 'import json,sys,os,time
path=sys.argv[1]
try:
 age=time.time()-os.path.getmtime(path)
 data=json.load(open(path,encoding="utf-8"))
 if data.get("schema")!="omen-a4-gate-state.v1": raise ValueError()
 if age>172800: print("Omen A4 gates: state_stale severity=medium")
 elif data.get("enabled_now") is True: print("Omen A4 gates: TUESDAY SCORING ENABLED automatically - all gates passed")
 elif data.get("ready") is True and data.get("action")=="awaiting_control_file":
  print("Omen A4 gates: ALL GATES PASS - scoring is ready to enable (auto-enable control file not set)")
 elif data.get("ready") is True: print("Omen A4 gates: ALL GATES PASS")
 elif data.get("status")=="checker_unavailable": print("Omen A4 gates: checker_unavailable severity=medium")
except Exception:
 print("Omen A4 gates: state_unreadable severity=medium")' /var/lib/omen-a4-gates/state.json)"
a4_old="$(cat "$a4_state" 2>/dev/null || true)"
if [ "$a4" != "$a4_old" ]; then
  if [ -n "$a4" ]; then
    send "SLOPS ALERT: Omen A4 scoring-gate state change
$a4"
  elif [ -n "$a4_old" ]; then
    send 'SLOPS RECOVERY: Omen A4 scoring-gate state is back to nothing notable.'
  fi
  printf '%s\n' "$a4" > "$a4_state"
fi
sig="$(printf '%s\n%s\n%s\n%s\n%s' "$bad" "$kuma" "$pihole" "$glitchtip" "$stale" | sed '/^$/d' | sort)"
old="$(cat "$state" 2>/dev/null || true)"
today="$(date -u +%Y-%m-%d)"
# Unchanged signature: stay quiet, EXCEPT once per day while anything is still
# active. The reminder deliberately spans the football and A4 signatures too -
# those latch in their own state files and were the ones that went silent, so a
# reminder that only covered "$sig" would have missed the 17-day outage entirely.
if [ "$sig" = "$old" ]; then
  active="$(printf '%s\n%s' "$sig" "$football" | sed '/^$/d')"
  [ -z "$active" ] && exit 0
  [ "$today" = "$(cat "$reminder_state" 2>/dev/null || true)" ] && exit 0
  send "SLOPS REMINDER: these conditions are still active
$active"
  printf '%s\n' "$today" > "$reminder_state"
  exit 0
fi
# Deliver BEFORE persisting. The old order recorded the new signature first, so
# a failed send was never retried - the state said "already reported" for an
# alert that never left the machine. Under set -e a failed send exits non-zero
# with the state untouched, and the next run retries.
if [ -n "$sig" ]; then send "SLOPS ALERT: CRITICAL state change
$sig"; elif [ -n "$old" ]; then send 'SLOPS RECOVERY: previously reported alert conditions are healthy again.'; fi
printf '%s\n' "$sig" > "$state"
# A real alert counts as today's notification: no reminder on top of it.
printf '%s\n' "$today" > "$reminder_state"
