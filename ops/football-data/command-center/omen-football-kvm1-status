#!/bin/sh
set -eu
root=/var/lib/omen-football-witness
temporary="$(mktemp "$root/remote/.kvm1-status.XXXXXX")"
trap 'rm -f "$temporary"' EXIT HUP INT TERM
ssh -F /dev/null \
  -i "$root/ssh/id_ed25519" \
  -o BatchMode=yes \
  -o ConnectTimeout=10 \
  -o IdentitiesOnly=yes \
  -o StrictHostKeyChecking=yes \
  -o UserKnownHostsFile="$root/ssh/known_hosts" \
  omen-football-status@srv1737978 status > "$temporary"
chmod 0640 "$temporary"
mv "$temporary" "$root/remote/kvm1-status.json"
trap - EXIT HUP INT TERM
