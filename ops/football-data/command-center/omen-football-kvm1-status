#!/bin/sh
# --help prints this and exits before anything runs (STANDARDS card E, rule 7).
case "${1:-}" in
  -h|--help) cat <<'USAGE'
omen-football-kvm1-status (Pi command center, called by omen-football-witness-monitor)
Fetches KVM1's football status JSON over the read-only SSH channel into
/var/lib/omen-football-witness/remote. No arguments. Exit 0 on success, non-zero if the fetch fails.
USAGE
    exit 0 ;;
esac
set -eu
root=/var/lib/omen-football-witness
temporary="$(mktemp "$root/remote/.kvm1-status.XXXXXX")"
trap 'rm -f "$temporary"' EXIT HUP INT TERM
ssh -F /dev/null \
  -i "$root/ssh/id_ed25519" \
  -o BatchMode=yes \
  -o ConnectTimeout=10 \
  -o IdentitiesOnly=yes \
  -o StrictHostKeyChecking=yes \
  -o UserKnownHostsFile="$root/ssh/known_hosts" \
  omen-football-status@srv1737978 status > "$temporary"
chmod 0640 "$temporary"
mv "$temporary" "$root/remote/kvm1-status.json"
trap - EXIT HUP INT TERM
