#!/bin/sh
# --help prints this and exits before anything runs (STANDARDS card E, rule 7).
case "${1:-}" in
  -h|--help) cat <<'USAGE'
omen-football-witness-monitor (Pi command center, by its timer)
Fetches KVM1's football status and compares it with the witness; raises witness_outage when the
fetch fails. No arguments. Exit 0 unless the comparison itself errors.
USAGE
    exit 0 ;;
esac
set -eu
root=/var/lib/omen-football-witness
if ! /usr/local/libexec/omen-football-kvm1-status; then
  exec /usr/local/libexec/omen-football-witness exercise --code witness_outage --state active
fi
result=0
/usr/local/libexec/omen-football-witness compare --status-file "$root/remote/kvm1-status.json" || result=$?
case "$result" in
  0|2|3) exit 0 ;;
  *) exit "$result" ;;
esac
