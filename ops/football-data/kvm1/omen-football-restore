#!/bin/sh
set -eu
umask 077

EXPECTED_HOST=srv1737978
BACKUP_USER=omen-backup-client
BACKUP_HOME=/var/lib/omen-backup-client
RESTORE_ROOT=/var/lib/omen-football-restore-source
RESTORED_STATE_ROOT=$RESTORE_ROOT/var/lib/omen-football-data
COMMISSIONED_BACKUP=/opt/omen-backup/bin/backup-supabase.sh
RESTIC_PASSWORD_FILE=$BACKUP_HOME/restic-password
ACCEPTANCE_SHA256=5c4cbc0568ce85a94512b7722144a7cddcb83fe74bd088f04d90f7a628a00bea

[ "$(hostname)" = "$EXPECTED_HOST" ] || {
  echo "omen-football-restore: wrong host" >&2
  exit 69
}
[ "$(id -u)" -eq 0 ] || {
  echo "omen-football-restore: root orchestration is required" >&2
  exit 77
}
[ -d "$RESTORE_ROOT" ] || {
  echo "omen-football-restore: founder must pre-create the dedicated restore target" >&2
  exit 66
}
[ -z "$(find "$RESTORE_ROOT" -mindepth 1 -maxdepth 1 -print -quit)" ] || {
  echo "omen-football-restore: fresh restore target must start empty" >&2
  exit 65
}

snapshot_id="${1:-}"
printf '%s\n' "$snapshot_id" | grep -Eq '^[a-fA-F0-9]{64}$' || {
  echo "omen-football-restore: an exact 64-character snapshot ID is required" >&2
  exit 64
}
restic_repository="$(sed -n 's/^RESTIC_REPOSITORY="\([^"]*\)"$/\1/p' "$COMMISSIONED_BACKUP")"
[ -n "$restic_repository" ] || {
  echo "omen-football-restore: commissioned repository assignment is invalid" >&2
  exit 78
}

runuser \
  -u "$BACKUP_USER" \
  -- \
  env \
    HOME="$BACKUP_HOME" \
    RESTIC_REPOSITORY="$restic_repository" \
    RESTIC_PASSWORD_FILE="$RESTIC_PASSWORD_FILE" \
  restic restore \
    "$snapshot_id" \
    --target "$RESTORE_ROOT" \
    --no-cache \
    --verify

printf '%s  %s\n' \
  "$ACCEPTANCE_SHA256" \
  "$RESTORED_STATE_ROOT/evidence/$ACCEPTANCE_SHA256/acceptance.json" \
  | sha256sum --check --status || {
    echo "omen-football-restore: restored acceptance hash mismatch" >&2
    exit 65
  }
chown -R omen-football:omen-football "$RESTORED_STATE_ROOT"

printf 'omen-football-restore: snapshot %s verified\n' "$snapshot_id"
