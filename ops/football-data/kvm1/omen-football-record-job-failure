#!/bin/sh
# --help prints this and exits before anything runs (STANDARDS card E, rule 7).
case "${1:-}" in
  -h|--help) cat <<'USAGE'
omen-football-record-job-failure [UNIT] (KVM1, systemd OnFailure= hook)
Records a job_failure in the football status files, naming UNIT (an omen-football-*.service).
Does nothing if a job_failure is already recorded. Exit 0 when recorded.
USAGE
    exit 0 ;;
esac
set -eu
umask 027
root=/var/lib/omen-football-data
if [ -f "$root/exports/status.json" ] && grep -Eq '"code"[[:space:]]*:[[:space:]]*"job_failure"' "$root/exports/status.json"; then
  exit 0
fi
case "${1:-}" in
  omen-football-*.service) unit=$1 ;;
  *) unit=omen-football-unknown.service ;;
esac
generated="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
for target in "$root/status/current.json" "$root/exports/status.json"; do
  directory="$(dirname "$target")"
  mkdir -p "$directory"
  temporary="$(mktemp "$directory/.job-failure.XXXXXX")"
  printf '{\n  "schema": "omen-football-production-status.v1",\n  "generated_at_utc": "%s",\n  "job": "%s",\n  "state": "failed",\n  "batch_id": null,\n  "datasets": {},\n  "alerts": [{"code": "job_failure", "severity": "high"}],\n  "publication_authorized": false,\n  "production_scoring_authorized": false\n}\n' "$generated" "$unit" > "$temporary"
  chmod 0640 "$temporary"
  mv "$temporary" "$target"
done
