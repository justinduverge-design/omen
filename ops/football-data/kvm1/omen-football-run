#!/bin/sh
set -eu

case "${1:-}" in
  # Status is an already-produced, payload-free export. Keeping this read path
  # independent of Docker means an operator can inspect the last verified
  # capture even after the local, content-addressed image cache is pruned. The
  # guarded capture/validate/publish paths below still require the SHA-pinned
  # image and retain every container restriction.
  status) exec cat /var/lib/omen-football-data/exports/status.json ;;
esac

image_file=/etc/omen-football/image-digest
image="$(cat "$image_file")"

printf '%s\n' "$image" | grep -Eq '^(sha256:[a-f0-9]{64}|[^[:space:]@]+@sha256:[a-f0-9]{64})$' || {
  printf '%s\n' 'omen-football-run: image must be pinned by sha256 digest' >&2
  exit 64
}

case "${1:-}" in
  capture-set) network=bridge ;;
  validate-batch|import-phase3|recover-phase3|publish) network=none ;;
  *) printf '%s\n' 'omen-football-run: unsupported command' >&2; exit 64 ;;
esac

extra_mounts=
if [ "${1:-}" = recover-phase3 ]; then
  extra_mounts='--volume /var/lib/omen-football-restore-source:/backup:ro --volume /var/lib/omen-football-recovery:/recovery:rw'
fi

uid="$(id -u omen-football)"
gid="$(id -g omen-football)"

exec docker run --rm \
  --name "omen-football-${1}-$$" \
  --user "$uid:$gid" \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --read-only \
  --network "$network" \
  --pids-limit 128 \
  --memory 1536m \
  --cpus 1.0 \
  --tmpfs /tmp:rw,noexec,nosuid,nodev,size=64m \
  --volume /var/lib/omen-football-data:/state:rw \
  $extra_mounts \
  "$image" "$@"
