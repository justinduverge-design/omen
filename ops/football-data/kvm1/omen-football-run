#!/bin/sh
# --help prints this and exits before anything runs (STANDARDS card E, rule 7).
case "${1:-}" in
  -h|--help) cat <<'USAGE'
omen-football-run COMMAND [ARGS] (KVM1, by the football timers)
Runs one football-data command in the pinned capture image, in a locked-down container.
  COMMAND  capture-set | validate-batch | status | import-phase3 | recover-phase3 | publish
Exit: the command's own code; 64 for an unknown command or an image not pinned by digest.
USAGE
    exit 0 ;;
esac
set -eu

image_file=/etc/omen-football/image-digest
image="$(cat "$image_file")"

printf '%s\n' "$image" | grep -Eq '^(sha256:[a-f0-9]{64}|[^[:space:]@]+@sha256:[a-f0-9]{64})$' || {
  printf '%s\n' 'omen-football-run: image must be pinned by sha256 digest' >&2
  exit 64
}

case "${1:-}" in
  capture-set) network=bridge ;;
  validate-batch|status|import-phase3|recover-phase3|publish) network=none ;;
  *) printf '%s\n' 'omen-football-run: unsupported command' >&2; exit 64 ;;
esac

extra_mounts=
if [ "${1:-}" = recover-phase3 ]; then
  extra_mounts='--volume /var/lib/omen-football-restore-source:/backup:ro --volume /var/lib/omen-football-recovery:/recovery:rw'
fi

uid="$(id -u omen-football)"
gid="$(id -g omen-football)"

exec docker run --rm \
  --name "omen-football-${1}-$$" \
  --user "$uid:$gid" \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --read-only \
  --network "$network" \
  --pids-limit 128 \
  --memory 1536m \
  --cpus 1.0 \
  --tmpfs /tmp:rw,noexec,nosuid,nodev,size=64m \
  --volume /var/lib/omen-football-data:/state:rw \
  $extra_mounts \
  "$image" "$@"
