[Unit]
Description=Record payload-free Omen football-data job failure for %i

[Service]
Type=oneshot
User=omen-football
Group=omen-football
ExecStart=/usr/local/libexec/omen-football-record-job-failure %i
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/omen-football-data
RestrictAddressFamilies=AF_UNIX
UMask=0027
