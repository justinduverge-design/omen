#!/bin/sh
# --help prints this and exits before anything runs (STANDARDS card E, rule 7).
case "${1:-}" in
  -h|--help) cat <<'USAGE'
omen-football-status-export (KVM1, forced command on the read-only status SSH key)
Prints one state file, chosen by SSH_ORIGINAL_COMMAND: "status" (default, football status),
"a4-gates" (A4 gate state) or "sight-status" (Sight's aggregate for the Valor loop board, written
hourly by omen-sight-status.timer). Exit 0 on success, 64 for any other command.
USAGE
    exit 0 ;;
esac
set -eu
# Two read-only subcommands over one restricted channel. A4 gate state reuses this key,
# user and known-hosts entry rather than provisioning a second SSH identity for one small
# JSON file — less new surface, and the channel is already forced-command and read-only.
case "${SSH_ORIGINAL_COMMAND:-status}" in
  status)   exec cat /var/lib/omen-football-data/exports/status.json ;;
  a4-gates) exec cat /var/lib/omen-a4-gates/state.json ;;
  sight-status) exec cat /var/lib/omen-sight-status/status.json ;;
  *)        exit 64 ;;
esac
