[Unit]
Description=Omen football-data immutable capture
Wants=network-online.target docker.service
After=network-online.target docker.service
ConditionPathExists=/etc/omen-football/image-digest
OnFailure=omen-football-failure@%n.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/omen-football-run capture-set
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/omen-football-data /run/docker.sock
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027

[Install]
WantedBy=multi-user.target
