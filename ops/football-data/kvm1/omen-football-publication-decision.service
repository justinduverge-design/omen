[Unit]
Description=Condition-gated Omen football-data publication decision
After=omen-football-validate.service docker.service
Requires=docker.service
ConditionPathExists=/var/lib/omen-football-data/control/publication-enabled
OnFailure=omen-football-failure@%n.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/omen-football-publication-decision
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/omen-football-data /run/docker.sock
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027
