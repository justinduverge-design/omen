[Unit]
Description=Pull Omen A4 scoring-gate state from KVM1
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=omen-football
Group=omen-football
ExecStart=/usr/local/libexec/omen-a4-gates-pull
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/omen-a4-gates
