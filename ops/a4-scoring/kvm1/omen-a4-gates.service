[Unit]
Description=Evaluate Omen A4 Tuesday-scoring enablement gates
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/omen-a4-gates-run
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/omen-a4-gates /opt/omen/deploy/hostinger
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
