#!/bin/sh
# --help prints this and exits before anything runs (STANDARDS card E, rule 7).
case "${1:-}" in
  -h|--help) cat <<'USAGE'
slops-power-check HOST [STATE_FILE [HISTORY_FILE]] (any Pi; by the dispatcher on Command Center, by its timer everywhere)
Reads `vcgencmd get_throttled` and `vcgencmd measure_temp` and prints two lines:
  result=HEALTHY|WARNING|CRITICAL|DOWN check=HOST-under-voltage reason=... throttled=0x...
  result=HEALTHY|WARNING|CRITICAL|DOWN check=HOST-thermal reason=... temp_band=NN-NNC throttled=0x...
With STATE_FILE it also writes both lines atomically (mode 0644) for the status reader.
With HISTORY_FILE it appends `<UTC time> temp=<C> throttled=<hex>` and keeps the last 2016 lines (7 days at 5 min).
Exit 0 whatever the result; the result is in the lines.
USAGE
    exit 0 ;;
esac
# Under-voltage is the early warning for a dying power supply; heat and throttling are the early warning for a bad
# case, a dead fan or a blocked vent (B13-HEAL-WATCHDOG). get_throttled bits:
#   now:        0x1 under-voltage, 0x2 frequency capped, 0x4 throttled, 0x8 soft temperature limit
#   since boot: 0x10000 under-voltage, 0x20000 capped, 0x40000 throttled, 0x80000 soft temperature limit
# Read-only: it reports and never changes clocks, power or anything else. "under-voltage" in the check name adds the
# parts-list link (B13-HEAL-PARTS-LIST). The thermal line carries a 10-degree band, not the exact temperature: a
# non-healthy line is part of the dispatcher's signature, and an exact reading would re-send the alert every run.
# The exact reading goes to HISTORY_FILE.
set -eu
host="${1:?usage: slops-power-check HOST [STATE_FILE [HISTORY_FILE]]}"
state="${2:-}"
history="${3:-}"
vc="${VCGENCMD:-vcgencmd}"
raw="$($vc get_throttled 2>/dev/null || true)"
hex="${raw#throttled=}"
traw="$($vc measure_temp 2>/dev/null || true)"
temp="${traw#temp=}"
temp="${temp%\'C}"
case "$temp" in
  ''|*[!0-9.]*|*.*.*) temp="" ;;
esac
case "$hex" in
  # Not hex: the arithmetic below would abort with no output, which a reader could take for healthy.
  0x|0x*[!0-9a-fA-F]*) v="" ;;
  0x*) v=$((hex)) ;;
  *) v="" hex=unknown ;;
esac

if [ -z "$v" ]; then result=DOWN reason=get_throttled_unreadable
elif [ $((v & 0x1)) -ne 0 ]; then result=CRITICAL reason=under_voltage_now
elif [ $((v & 0x10000)) -ne 0 ]; then result=WARNING reason=under_voltage_since_boot
elif [ $((v & 0x4)) -ne 0 ]; then result=WARNING reason=throttled_now
else result=HEALTHY reason=none
fi
power="result=$result check=$host-under-voltage reason=$reason throttled=$hex"

if [ -z "$v" ] || [ -z "$temp" ]; then
  [ -z "$v" ] && treason=get_throttled_unreadable || treason=measure_temp_unreadable
  thermal="result=DOWN check=$host-thermal reason=$treason temp_band=unknown throttled=$hex"
else
  whole="${temp%%.*}"
  low=$(( whole / 10 * 10 ))
  tresult=HEALTHY reasons=""
  add() { reasons="${reasons:+$reasons,}$1"; }
  if [ "$whole" -ge 80 ]; then tresult=CRITICAL; add hot_now
  elif [ "$whole" -ge 70 ]; then tresult=WARNING; add warm_now
  fi
  [ $((v & 0x2)) -ne 0 ] && add capped_now
  [ $((v & 0x4)) -ne 0 ] && add throttled_now
  [ $((v & 0x8)) -ne 0 ] && add soft_temp_limit_now
  [ $((v & 0x20000)) -ne 0 ] && add capped_since_boot
  [ $((v & 0x40000)) -ne 0 ] && add throttled_since_boot
  [ $((v & 0x80000)) -ne 0 ] && add soft_temp_limit_since_boot
  if [ -n "$reasons" ] && [ "$tresult" = HEALTHY ]; then tresult=WARNING; fi
  thermal="result=$tresult check=$host-thermal reason=${reasons:-none} temp_band=$low-$((low + 9))C throttled=$hex"
fi

printf '%s\n%s\n' "$power" "$thermal"
if [ -n "$state" ]; then
  tmp="$(mktemp "$state.XXXXXX")"
  printf '%s\n%s\n' "$power" "$thermal" > "$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$state"
fi
if [ -n "$history" ]; then
  printf '%s temp=%s throttled=%s\n' "$(date -u +%Y-%m-%dT%H:%MZ)" "${temp:-unknown}" "$hex" >> "$history"
  if [ "$(wc -l < "$history")" -gt 2016 ]; then
    tmp="$(mktemp "$history.XXXXXX")"
    tail -n 2016 "$history" > "$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$history"
  fi
fi
