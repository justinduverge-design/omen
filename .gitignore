.env
.env.*
!.env.example
*.key
*.pem
*.cert
*.crt
*.p12
*.pfx

# Local databases
*.db
*.db-shm
*.db-wal

# Logs
*.log
logs/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Built SPA artifacts
dist/
client/dist/
client/node_modules/
frontend/dist/
frontend/node_modules/

# Native local tooling
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/**/build/
mobile/ios/**/DerivedData/
mobile/ios/**/.swiftpm/
mobile/ios/**/Config/Local.xcconfig
# Xcode regenerates this self-only manifest when a project opens. Keep any future
# shared workspace metadata (for example SwiftPM resolution) visible to Git.
mobile/ios/**/*.xcodeproj/project.xcworkspace/contents.xcworkspacedata
# Per-user IDE state (window layout, breakpoints). Leaks local usernames/paths and churns.
**/xcuserdata/
