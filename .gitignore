# Dependencies
node_modules/
.claude/

# Secrets - NEVER COMMIT
.env
.env.*
!.env.example
# Secrets carried in by hand under a non-.env name. `env.md` holds a Supabase
# service key and the Yahoo client secret; it was untracked but NOT ignored, so
# any `git add .` would have committed them.
env.md
env*.md
!env.example.md
*.key
*.pem
*.cert
*.crt
*.p12
*.pfx

# Local databases
*.db
*.db-shm
*.db-wal

# Logs
*.log
logs/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Built SPA artifacts
dist/
client/dist/
client/node_modules/
frontend/dist/
frontend/node_modules/

# Native local tooling
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/**/build/
mobile/ios/**/DerivedData/
# Repo-root derived data. `native-visual-evidence.yml` and the DoD's local iOS substitute
# both build with `-derivedDataPath build/ios`, so a local run drops ~thousands of object
# files here. Only `mobile/ios/**/DerivedData/` was ignored, so they were staged by `git add -A`.
/build/
mobile/ios/**/.swiftpm/
mobile/ios/**/Config/Local.xcconfig
# Xcode regenerates this self-only manifest when a project opens. Keep any future
# shared workspace metadata (for example SwiftPM resolution) visible to Git.
mobile/ios/**/*.xcodeproj/project.xcworkspace/contents.xcworkspacedata
# Per-user IDE state (window layout, breakpoints). Leaks local usernames/paths and churns.
**/xcuserdata/

# Local Codex CLI preferences — machine-specific, never shared.
# Committed by accident 2026-08-30 via `git add -A`; it carries
# approval_policy="never" and sandbox_mode="danger-full-access", which must
# not become anyone else's default just because they cloned the repo.
.Codex/

# Backups and copies of secret files. `mobile/android/local.properties.bak-173445`
# was committed and pushed with the release keystore password in it, because the
# ignore rule matched the exact filename and nothing else.
*.bak
*.bak-*
local.properties*
!local.properties.example
*Local.xcconfig
!Local.xcconfig.example
