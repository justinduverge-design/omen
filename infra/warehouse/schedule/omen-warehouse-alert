#!/bin/sh
# Reports the warehouse ingest's state to the Uptime Kuma push monitor on the Pi
# (installed to /usr/local/sbin on KVM1).
#   omen-warehouse-alert up          after a successful run (called by the run script)
#   omen-warehouse-alert <unit>      on failure (omen-warehouse-alert@.service, from OnFailure)
# Kuma then alerts through its own Discord notification, so this host never holds the Discord webhook.
# The push URL lives in a root-only file and is never printed; only a fixed status and message are sent.
set -eu
arg=${1:?state or unit required}
url_file=/etc/omen-warehouse/kuma-push-url
[ -r "$url_file" ] || { echo "omen-warehouse-alert: no Kuma push URL file; nothing sent" >&2; exit 0; }
base=$(sed 's/?.*//' "$url_file" | tr -d '\n\r ')
case "$base" in
  http://*/api/push/*|https://*/api/push/*) ;;
  *) echo "omen-warehouse-alert: Kuma push URL file is not a push URL; nothing sent" >&2; exit 0 ;;
esac
if [ "$arg" = up ]; then
  query='status=up&msg=ingest%20succeeded'
else
  query='status=down&msg=warehouse%20ingest%20failed%20on%20omen-prod%3A%20journalctl%20-u%20omen-warehouse-ingest'
fi
curl -fsS --max-time 15 -o /dev/null "$base?$query"
