FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force

FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS production

ARG GIT_SHA
ARG BUILD_ID
RUN case "$GIT_SHA" in (*[!0-9a-f]*|???????????????????????????????????????|?????????????????????????????????????????*) exit 1;; esac \
    && case "$BUILD_ID" in (''|*[!0-9]*) exit 1;; esac
LABEL org.opencontainers.image.revision=$GIT_SHA \
      org.opencontainers.image.source="https://github.com/justinduverge-design/omen" \
      com.omen.warehouse.worker="current-season" \
      com.omen.build-id=$BUILD_ID

RUN addgroup -S omen && adduser -S -G omen -u 10001 omen
WORKDIR /app
COPY --from=dependencies --chown=10001:10001 /app/node_modules ./node_modules
COPY --chown=10001:10001 package.json ./
COPY --chown=10001:10001 src ./src

ENV NODE_ENV=production
USER 10001:10001
ENTRYPOINT ["node", "/app/src/omen_football_warehouse_current_season.js"]
CMD ["config"]
